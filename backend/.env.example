# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration (MongoDB Atlas or Local/In-Memory fallback)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/securework_verify?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=24h

# File & Key Storage Paths (relative to backend root or absolute)
KEY_STORAGE_PATH=./keys
STORAGE_PATH=./storage/documents
TEMP_STORAGE_PATH=./storage/temp
MAX_FILE_SIZE_MB=10

# Storage Driver Selection: local | cloudinary (default local)
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=securework-verify

# Client Integration
FRONTEND_URL=http://localhost:5173

# Feature Flags & Engine Drivers
OCR_ENABLED=true
AI_ENABLED=true
OCR_ENGINE=local
AI_ENGINE=local
